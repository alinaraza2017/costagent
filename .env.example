# Copy this file to .env in the project root before starting the backend.
# Replace every placeholder. Never commit the real .env file.

# Required. Use a long random string in any shared or production environment.
SECRET_KEY=replace-with-a-long-random-string

# HS256 is the local default. Change both the algorithm and key together if you rotate them.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite is the local default. For PostgreSQL, point this at a persistent database.
# Example: postgresql+psycopg://costwise:password@localhost:5432/costwise
DATABASE_URL=sqlite:///./data/costwise.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits understood by the limits library, for example 5/minute.
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=10/minute
SENSITIVE_RATE_LIMIT=20/minute

MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_ROWS=500
MAX_JSON_BYTES=1048576

# bcrypt cost. Use 12 outside automated tests. Tests set this to 4.
BCRYPT_ROUNDS=12

# Leave the API key empty to use local rule-based insights.
# The key is read only on the server and is never sent to the browser.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Keep false outside local debugging. Debug mode must stay off in production.
DEBUG=false
